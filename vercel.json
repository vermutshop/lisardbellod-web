{
  "outputDirectory": ".",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path((?!api/telegram-metrics/?$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.lisardbellod.com"
        }
      ],
      "destination": "https://lisardbellod.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog-sitemap.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/calcotadas/:path*",
      "destination": "/blog/calcotadas/",
      "statusCode": 301
    },
    {
      "source": "/calcotades/:path*",
      "destination": "/blog/calcotades/",
      "statusCode": 301
    },
    {
      "source": "/que-es-esto/:path*",
      "destination": "/blog/que-es-esto/",
      "statusCode": 301
    },
    {
      "source": "/top-pinscher/:path*",
      "destination": "/blog/top-pinscher/",
      "statusCode": 301
    },
    {
      "source": "/carcasas/:path*",
      "destination": "/blog/carcasas/",
      "statusCode": 301
    },
    {
      "source": "/blog/paginas/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/paginas/:path*",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ai/explorar-lisard-bellod/SKILL.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/server-proxy.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/((?!api/telegram-metrics/?$|api/server-proxy/?$).*)",
      "dest": "/api/server-proxy?__origin_path=$1"
    }
  ]
}
